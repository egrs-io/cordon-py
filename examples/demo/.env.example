# Copy to .env, fill in, then `source .env` before running with --live.
# This file is checked in. Your real .env is gitignored.

# A GitHub Personal Access Token with the `delete_repo` scope.
# https://github.com/settings/tokens (fine-grained or classic both work).
export CORDON_DEMO_GITHUB_TOKEN=ghp_replace_me

# An incoming Slack webhook URL. The unprotected run POSTs the
# (fake-shaped) AWS key to this channel. Rotate it after demos -- the
# full URL is captured in the audit log.
# https://api.slack.com/messaging/webhooks
export CORDON_DEMO_SLACK_WEBHOOK=https://hooks.slack.com/services/T.../B.../...
